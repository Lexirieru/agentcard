{
  "name": "giwacard",
  "version": "0.0.1",
  "description": "Agent-native virtual cards on GIWA Sepolia: chain clients, encrypted keystore, and CLI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "giwacard": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "giwa",
    "op-stack",
    "viem",
    "agent",
    "mcp",
    "x402"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "boxen": "^8.0.1",
    "cli-table3": "^0.6.5",
    "figlet": "^1.11.4",
    "gradient-string": "^3.0.0",
    "hono": "^4.12.33",
    "viem": "^2.40.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.9",
    "@types/figlet": "^1.7.0",
    "@types/node": "^20.19.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.0"
  }
}
